# Copy this file to .env and fill in your Supabase project details.
# Find these under Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google OAuth Client ID used for the admin login button (Google Identity
# Services, client-side ID-token flow — public value, not a secret).
# Find it in Google Cloud Console > APIs & Services > Credentials.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
